{
  "name": "@movieser/silent-persistence",
  "version": "0.0.0",
  "description": "Non-blocking persistence layer for media apps. Web Worker SharedArrayBuffer + Atomics offload, IndexedDB Write-Ahead Log with delta-batching. Zero visual / zero notification. Target P95 <50 ms with 0% requestAnimationFrame drops (rAF) interrupts.",
  "license": "MIT OR Apache-2.0",
  "author": "Solhei Solutions <hello@solhei-solutions.nl>",
  "homepage": "https://movieser.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amorec/movieser-engine",
    "directory": "packages/silent-persistence"
  },
  "keywords": [
    "indexeddb",
    "opfs",
    "persistence",
    "offline-first",
    "web-worker",
    "sharedarraybuffer",
    "atomics",
    "non-blocking",
    "raf",
    "requestanimationframe",
    "last-write-wins",
    "write-ahead-log"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "require": "./dist/worker.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/worker.ts --format cjs,esm --dts --clean --minify",
    "dev": "tsup src/index.ts src/worker.ts --format cjs,esm --dts --watch",
    "test": "vitest run --no-file",
    "test:watch": "vitest",
    "test:ios": "tsx tests/ios-safari-sim.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fake-indexeddb": "^6.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
